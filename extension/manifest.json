{
  "manifest_version": 3,
  "name": "Webtwist",
  "version": "1.0",
  "description": "Theme websites with your Omarchy desktop colors and keep them in sync when your theme changes.",
  "browser_specific_settings": {
    "gecko": {
      "id": "webtwist@signaldirective.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "scripts": [
      "presets.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Webtwist",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "commands": {
    "toggle-site-theming": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "Toggle Webtwist theming on the current site"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "autotheme.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "page-api.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://wallpapers.hel1.your-objectstorage.com/*"
  ]
}
